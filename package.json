{
	"name": "expo-starter",
	"version": "1.0.0",
	"scripts": {
		"android": "expo start --android",
		"e2e:build": "detox build --configuration ios.sim.debug",
		"e2e:test": "detox test --configuration ios.sim.debug",
		"eject": "expo eject",
		"flow": "flow",
		"ios": "expo start --ios",
		"start": "expo start",
		"test": "jest --watch",
		"web": "expo start --web"
	},
	"dependencies": {
		"@react-native-async-storage/async-storage": "^1.17.7",
		"@react-navigation/bottom-tabs": "^6.3.1",
		"@react-navigation/native": "^6.0.10",
		"@react-navigation/native-stack": "^6.6.2",
		"@react-navigation/stack": "^6.2.1",
		"@rneui/base": "^4.0.0-rc.5",
		"@rneui/themed": "^4.0.0-rc.5",
		"axios": "^0.27.2",
		"expo": "~45.0.0",
		"expo-location": "^14.2.2",
		"expo-status-bar": "~1.3.0",
		"i18n-js": "^3.9.2",
		"prop-types": "^15.8.1",
		"react": "17.0.2",
		"react-dom": "17.0.2",
		"react-native": "0.68.2",
		"react-native-gesture-handler": "~2.2.1",
		"react-native-safe-area-context": "4.2.4",
		"react-native-screens": "~3.11.1",
		"react-native-vector-icons": "^9.2.0",
		"react-native-web": "0.17.7"
	},
	"devDependencies": {
		"@babel/cli": "^7.18.6",
		"@babel/core": "^7.12.9",
		"@babel/preset-env": "^7.18.6",
		"@babel/preset-flow": "^7.18.6",
		"babel-jest": "^28.1.2",
		"babel-loader": "^8.2.5",
		"detox": "^19.7.1",
		"eslint": "^8.18.0",
		"eslint-plugin-node": "^11.1.0",
		"eslint-plugin-react": "^7.30.1",
		"eslint-plugin-react-native": "^4.0.0",
		"flow-bin": "^0.181.2",
		"jest": "^28.1.2",
		"jest-environment-node": "^28.1.2",
		"jest-expo": "^45.0.1",
		"prettier": "^2.7.1",
		"react-devtools": "^4.24.7",
		"react-test-renderer": "^18.2.0"
	},
	"jest": {
		"preset": "@testing-library/react-native",
		"setupFiles": [
			"jest-expo/jest-preset.js"
		],
		"setupFilesAfterEnv": [
			"@testing-library/react-native/jest-preset.js"
		],
		"transform": {
			".+\\.(png|jpg|ttf|woff|woff2)$": "jest-transform-stub"
		},
		"transformIgnorePatterns": [
			"node_modules/(?!(jest-)?react-native|@expo/vector-icons|react-clone-referenced-element|@react-native-community|expo(nent)?|@expo(nent)?/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|moment)"
		]
	},
	"private": true
}
